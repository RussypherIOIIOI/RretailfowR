{
  "datasets": [
    {
      "name": "publication",
      "displayName": "Publication",
      "queryLines": [
        "SELECT publication_id AS latest_publication_id, published_at AS latest_published_at,\n",
        "       explode(publication_ids) AS available_publication_id\n",
        "FROM publication\n"
      ],
      "catalog": "tmc_solutions_jvs",
      "schema": "retailflow_gold"
    },
    {
      "name": "sales_lines",
      "displayName": "Sales Lines",
      "queryLines": [
        "-- Bind publication_id once for every dataset on the dashboard.\n",
        "SELECT f.publication_id, f.order_id, f.line_id, f.order_date, f.sale_region,\n",
        "       f.customer_id, f.product_id, d.product_name, d.category,\n",
        "       concat(f.product_id, ' / ', d.product_name) AS product_label,\n",
        "       f.quantity, f.unit_price, f.discount_amount, f.net_sales,\n",
        "       f.snapshot_created_at\n",
        "FROM fact_order_line_snapshots f\n",
        "JOIN dim_product_snapshots d\n",
        "  ON f.product_id = d.product_id AND f.publication_id = d.publication_id\n",
        "JOIN publication p ON array_contains(p.publication_ids, f.publication_id)\n",
        "WHERE f.publication_id = :publication_id\n"
      ],
      "parameters": [
        {
          "displayName": "Registered publication",
          "keyword": "publication_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "demo04"
                }
              ]
            }
          }
        }
      ],
      "catalog": "tmc_solutions_jvs",
      "schema": "retailflow_gold"
    },
    {
      "name": "rejected_records",
      "displayName": "Rejected Records",
      "queryLines": [
        "SELECT r.publication_id, r.occurrence_id, r.batch_id, r.entity, r.filename,\n",
        "       r.record_index, r.raw_record, r.business_key, r.source_revision,\n",
        "       r.disposition, r.reasons, r.resolved, r.ruleset,\n",
        "       CASE WHEN NOT r.resolved THEN r.occurrence_id END AS unresolved_occurrence_id,\n",
        "       CASE WHEN r.resolved THEN r.occurrence_id END AS resolved_occurrence_id,\n",
        "       r.first_rejected_at, r.last_rejected_at, r.evaluated_at\n",
        "FROM rejected_records_snapshots r\n",
        "JOIN publication p ON array_contains(p.publication_ids, r.publication_id)\n",
        "WHERE r.publication_id = :publication_id\n"
      ],
      "parameters": [
        {
          "displayName": "Registered publication",
          "keyword": "publication_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "demo04"
                }
              ]
            }
          }
        }
      ],
      "catalog": "tmc_solutions_jvs",
      "schema": "retailflow_gold"
    },
    {
      "name": "rejected_reasons",
      "displayName": "Rejected Reasons",
      "queryLines": [
        "-- Reason counts overlap: one physical record can have several reasons.\n",
        "SELECT r.publication_id, r.batch_id, r.entity, reason,\n",
        "       count(DISTINCT r.occurrence_id) AS rejected_records\n",
        "FROM rejected_records_snapshots r\n",
        "JOIN publication p ON array_contains(p.publication_ids, r.publication_id)\n",
        "LATERAL VIEW explode(r.reasons) reasons AS reason\n",
        "WHERE r.publication_id = :publication_id AND NOT r.resolved\n",
        "GROUP BY r.publication_id, r.batch_id, r.entity, reason\n",
        "ORDER BY rejected_records DESC, reason\n"
      ],
      "parameters": [
        {
          "displayName": "Registered publication",
          "keyword": "publication_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "demo04"
                }
              ]
            }
          }
        }
      ],
      "catalog": "tmc_solutions_jvs",
      "schema": "retailflow_gold"
    }
  ],
